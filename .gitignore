# Python environments
.venv/
.venv-aihub/
.qaihub-venv/
.qaihub-workbench-venv/

# Python caches
__pycache__/
*.py[cod]
*.pyo

# Local logs
logs/

# Workbench backup/reset/corrupt state
workbench_state.json.corrupt_*
workbench_state.json.reset_*

# Backup files
*.bak

# Mock JSON artifacts
*.mock.json

# The local build scratch: ONNX graphs and their zips, hundreds of MB, rebuilt
# from source in about a minute by `aihub_workbench.py build`. It was committed
# once through Git LFS, which leaves a cloner without LFS holding 133-byte
# pointer files named .onnx -- worse than an honest absence.
workbench_build/

# Documents and presentations are generated from build_deck.py and
# build_brief.js and are not tracked -- except the three the submission is
# actually made of, which a judge should find without running anything.
*.docx
*.pdf
*.pptx
!SIGIL_Edge_Pitch.pptx
!SIGIL_Edge_Pitch.pdf
!SIGIL_Edge_Brief_Description.docx
